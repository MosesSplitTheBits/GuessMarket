<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Right-hand panel from AppScetch.png: title, then the two option order-book
  panes side by side, then a full-width participations panel below.
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.guessmarket.gui.controller.EventDetailController"
      spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label fx:id="eventTitleLabel" text="Select an event" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <!-- TODO: fill each pane with that option's trading info. For now
             (LMSR-only, Exercise 1 parity) that's name/share count/cost.
             Once Order Book exists, this becomes a bid/ask table + stats. -->
        <VBox fx:id="optionOnePane" HBox.hgrow="ALWAYS" style="-fx-border-color: gray;"/>
        <VBox fx:id="optionTwoPane" HBox.hgrow="ALWAYS" style="-fx-border-color: gray;"/>
    </HBox>

    <VBox fx:id="participationsPane" style="-fx-border-color: gray;"/>

</VBox>
