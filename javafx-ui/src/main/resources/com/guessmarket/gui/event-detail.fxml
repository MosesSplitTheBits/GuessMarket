<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Right-hand panel from AppScetch.png: title + status + Activate button, the
  two option panes side by side (name/shares/current price for LMSR, plus a
  buy-quantity Spinner+button and a "this wins"/close button — built in code
  in EventDetailController.showOptionPane since their enabled state depends
  on the acting user), then the event-wide account state + full trade
  history below. LMSR-only pricing for now — Order Book pricing is a
  separate mechanism, deliberately deferred.

  Wrapped in a ScrollPane (spec line 726: the grader resizes the window and
  expects content to stay usable rather than get clipped) — fitToWidth
  keeps horizontal space filled normally, and it only scrolls when the
  window gets too short for everything to fit, rather than squeezing or
  cutting anything off. minWidth on the two option panes protects the
  Order Book trading controls from getting cramped below a usable width;
  if the window is narrower than both panes need, the ScrollPane grows a
  horizontal scrollbar instead of clipping their contents silently.
-->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.guessmarket.gui.controller.EventDetailController"
            fitToWidth="true">
<VBox spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label fx:id="eventTitleLabel" text="Select an event"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-border-color: transparent transparent #888888 transparent; -fx-border-width: 0 0 2 0; -fx-padding: 0 0 6 0;"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="eventStatusLabel"/>
        <Button fx:id="activateButton" text="Activate Event" onAction="#handleActivate"/>
    </HBox>

    <HBox spacing="10">
        <VBox fx:id="optionOnePane" HBox.hgrow="ALWAYS" minWidth="260" style="-fx-border-color: gray;"/>
        <VBox fx:id="optionTwoPane" HBox.hgrow="ALWAYS" minWidth="260" style="-fx-border-color: gray;"/>
    </HBox>

    <Label fx:id="accountStateLabel" wrapText="true"/>

    <VBox fx:id="participantsPane" spacing="4">
        <Label text="Participant holdings:" style="-fx-font-weight: bold;"/>
        <ListView fx:id="participantsListView" prefHeight="90"/>
    </VBox>

    <Label text="Trade history:" style="-fx-font-weight: bold;"/>
    <ListView fx:id="tradeHistoryListView" prefHeight="200"/>

</VBox>
</ScrollPane>
