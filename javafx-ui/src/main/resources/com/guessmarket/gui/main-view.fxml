<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<!--
  Root layout, matching AppScetch.png: a top bar (Load File button + currently
  loaded file path) above a TabPane with an Events tab and a Users tab.
-->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.guessmarket.gui.controller.MainController">

    <!-- loadProgressBar  -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8"/>
            </padding>
            <Button fx:id="loadFileButton" text="Load File" onAction="#handleLoadFile"/>
            <Label fx:id="filePathLabel" text="No file loaded"/>
            <ProgressBar fx:id="loadProgressBar" progress="0" visible="false"/>
            <!-- A growing Region on each side of the "Acting as" group splits
                 the leftover space evenly, hugging the group toward the middle
                 instead of pushing it all the way to the right. -->
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Acting as:"/>
            <ComboBox fx:id="currentUserComboBox" promptText="Select user"/>
            <Label fx:id="currentUserLabel" text="Hello, guest"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane">
            <Tab text="Events" closable="false">
                <fx:include fx:id="eventsTab" source="events-tab.fxml"/>
            </Tab>
            <Tab text="Users" closable="false">
                <fx:include fx:id="usersTab" source="users-tab.fxml"/>
            </Tab>
        </TabPane>
    </center>

</BorderPane>
