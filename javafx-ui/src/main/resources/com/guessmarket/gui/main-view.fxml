<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<!--
  Root layout, matching AppScetch.png: a top bar (Load File button + currently
  loaded file path) above a TabPane with an Events tab and a Users tab.
-->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.guessmarket.gui.controller.MainController">

    <!-- loadProgressBar isn't in the sketch, but the spec requires a progress
         indicator during file load — this is a reasonable first spot for it,
         revisit if it looks wrong once there's an actual load to watch. -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8"/>
            </padding>
            <Button fx:id="loadFileButton" text="Load File" onAction="#handleLoadFile"/>
            <Label fx:id="filePathLabel" text="No file loaded"/>
            <ProgressBar fx:id="loadProgressBar" progress="0" visible="false"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane">
            <Tab text="Events" closable="false">
                <fx:include fx:id="eventsTab" source="events-tab.fxml"/>
            </Tab>
            <Tab text="Users" closable="false">
                <fx:include fx:id="usersTab" source="users-tab.fxml"/>
            </Tab>
        </TabPane>
    </center>

</BorderPane>
