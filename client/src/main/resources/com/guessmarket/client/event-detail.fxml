<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Right-hand panel of the Events screen (Ex3 sketch: "Event details and
  trade", two option panes with their order books, participations): title +
  status + Activate button, the two option panes side by side (built in code
  ONCE per selected event by EventDetailController, then only their labels are
  updated on each poll so typed input is never wiped), then the event-wide
  account state, participant holdings and full trade history.

  Wrapped in a ScrollPane (spec: screens must stay usable when resized):
  fitToWidth fills the width normally and it scrolls instead of clipping when
  the window gets too small; minWidth keeps the trading controls usable.
-->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.guessmarket.client.events.EventDetailController"
            fitToWidth="true">
<VBox spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label fx:id="eventTitleLabel" text="Select an event"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-border-color: transparent transparent #888888 transparent; -fx-border-width: 0 0 2 0; -fx-padding: 0 0 6 0;"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="eventStatusLabel"/>
        <Button fx:id="activateButton" text="Activate Event" onAction="#handleActivate"/>
    </HBox>

    <HBox spacing="10">
        <VBox fx:id="optionOnePane" HBox.hgrow="ALWAYS" minWidth="260" style="-fx-border-color: gray;"/>
        <VBox fx:id="optionTwoPane" HBox.hgrow="ALWAYS" minWidth="260" style="-fx-border-color: gray;"/>
    </HBox>

    <Label fx:id="marketMakerLabel"/>
    <Label fx:id="accountStateLabel" wrapText="true"/>

    <VBox fx:id="participantsPane" spacing="4">
        <Label text="Participant holdings:" style="-fx-font-weight: bold;"/>
        <ListView fx:id="participantsListView" prefHeight="90"/>
    </VBox>

    <Label text="Trade history:" style="-fx-font-weight: bold;"/>
    <ListView fx:id="tradeHistoryListView" prefHeight="200"/>

</VBox>
</ScrollPane>
