<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<!-- Spec: login asks for a unique username only — no password, no sign-up. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.guessmarket.client.login.LoginController"
      alignment="CENTER" spacing="12">
    <padding>
        <Insets top="24" right="32" bottom="24" left="32"/>
    </padding>

    <Label text="Guess Market" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Choose a username"/>
    <TextField fx:id="usernameField" promptText="Username" maxWidth="260" onAction="#handleLogin"/>
    <Button fx:id="loginButton" text="Login" defaultButton="true" onAction="#handleLogin"/>
    <Label fx:id="errorLabel" style="-fx-text-fill: #c62828;" wrapText="true" maxWidth="340"/>
</VBox>
