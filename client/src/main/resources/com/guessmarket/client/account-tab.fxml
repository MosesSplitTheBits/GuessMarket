<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  Account screen, following the Ex3 sketch: left = file upload (button + path)
  and the users table; right = my account details (balance + load funds), the
  events I take part in / own, my involvement in the selected one, and the
  account history (ledger), one line per balance change.

  The right side is a ScrollPane (fitToWidth) so nothing is clipped when the
  window is resized small — it scrolls instead (spec: screens must stay usable
  on resize).
-->
<SplitPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.guessmarket.client.account.AccountController"
           dividerPositions="0.38">

    <VBox spacing="8">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="loadFileButton" text="Load File" onAction="#handleLoadFile"/>
            <Label fx:id="filePathLabel" text="No file loaded" wrapText="true"/>
        </HBox>
        <Label fx:id="uploadResultLabel" wrapText="true"/>

        <Label text="Users" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="userNameColumn" text="User"/>
                <TableColumn fx:id="userBalanceColumn" text="Balance"/>
                <TableColumn fx:id="userMmColumn" text="Market maker"/>
            </columns>
        </TableView>
    </VBox>

    <ScrollPane fitToWidth="true">
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label fx:id="accountNameLabel"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-border-color: transparent transparent #888888 transparent; -fx-border-width: 0 0 2 0; -fx-padding: 0 0 6 0;"/>
            <Label fx:id="accountBalanceLabel" style="-fx-font-size: 16px;"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Load funds:"/>
                <TextField fx:id="depositField" promptText="Amount" prefWidth="110" onAction="#handleDeposit"/>
                <Button fx:id="depositButton" text="Load" onAction="#handleDeposit"/>
                <Label fx:id="depositResultLabel" wrapText="true"/>
            </HBox>

            <Label text="My events (participant / market maker):" style="-fx-font-weight: bold;"/>
            <ListView fx:id="myEventsListView" prefHeight="110" minHeight="80"/>

            <Label fx:id="involvementTitleLabel" style="-fx-font-weight: bold;"/>
            <Label fx:id="holdingsLabel" wrapText="true"/>
            <ListView fx:id="myTradesListView" prefHeight="110" minHeight="80"/>
            <Label fx:id="closedSummaryLabel" wrapText="true"/>

            <Label text="Account history:" style="-fx-font-weight: bold;"/>
            <TableView fx:id="ledgerTable" prefHeight="230" minHeight="140">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="ledgerTimeColumn" text="Time" prefWidth="80"/>
                    <TableColumn fx:id="ledgerDescriptionColumn" text="Description" prefWidth="330"/>
                    <TableColumn fx:id="ledgerAmountColumn" text="Amount" prefWidth="90"/>
                    <TableColumn fx:id="ledgerBalanceColumn" text="Balance after" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </ScrollPane>

</SplitPane>
