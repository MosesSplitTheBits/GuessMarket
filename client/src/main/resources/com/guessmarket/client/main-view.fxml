<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<!-- Main window, following the Ex3 sketch: Events tab + Account tab. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.guessmarket.client.main.MainController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8"/>
            </padding>
            <Label fx:id="helloLabel" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <!-- Spec: the user sees their balance at every moment — so it lives
                 in the header, visible from both tabs. -->
            <Label fx:id="headerBalanceLabel" style="-fx-font-size: 15px;"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane">
            <Tab text="Events" closable="false" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 8 24 8 24;">
                <fx:include fx:id="eventsTab" source="events-tab.fxml"/>
            </Tab>
            <Tab text="Account" closable="false" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 8 24 8 24;">
                <fx:include fx:id="accountTab" source="account-tab.fxml"/>
            </Tab>
        </TabPane>
    </center>

</BorderPane>
